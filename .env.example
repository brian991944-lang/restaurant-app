# Copy to .env.local and fill in. Never commit real values.

# Postgres (Supabase) — pooled + direct connection strings used by Prisma.
DATABASE_URL=
DIRECT_URL=

# Supabase client (browser-safe publishable key).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clover POS sync.
CLOVER_MERCHANT_ID=
CLOVER_API_TOKEN=

# Google Places API (New) — public reviews feed (/api/public/reviews).
# Server-only; never exposed to the browser.
GOOGLE_PLACES_API_KEY=
# Optional. Defaults to Fusionista's place id when unset.
GOOGLE_PLACE_ID=

# Google Business Profile sync (/api/gbp/*). OAuth client "Fusionista Ops – GBP sync".
GBP_CLIENT_ID=
GBP_CLIENT_SECRET=
# Prod: https://restaurant-app-rust-xi.vercel.app/api/gbp/callback
GBP_REDIRECT_URI=http://localhost:3000/api/gbp/callback

# Bearer token for cron routes (/api/cron, /api/quickbooks/sync, /api/gbp/sync).
# Vercel Cron sends it automatically. Generate: openssl rand -hex 32
CRON_SECRET=

# Admin unlock password, checked server-side at /api/admin/login (runtime + locally required)
ADMIN_PASSWORD=

# Gift cards — the email goes out through Gmail SMTP as the restaurant's address.
# GIFTCARD_SMTP_PASS is a Google "App password" for that account (Google account →
# Security → 2-Step Verification → App passwords). Runtime only (Vercel).
GIFTCARD_SMTP_USER=fusionista.nj@gmail.com
GIFTCARD_SMTP_PASS=
