# Copy to .env.local and fill in. Never commit real values.

# Postgres (Supabase) — pooled + direct connection strings used by Prisma.
DATABASE_URL=
DIRECT_URL=

# Supabase client (browser-safe publishable key).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clover POS sync.
CLOVER_MERCHANT_ID=
CLOVER_API_TOKEN=

# Google Places API (New) — public reviews feed (/api/public/reviews).
# Server-only; never exposed to the browser.
GOOGLE_PLACES_API_KEY=
# Optional. Defaults to Fusionista's place id when unset.
GOOGLE_PLACE_ID=
