// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String?
  email        String?  @unique
  passwordHash String?
  role         String   @default("KITCHEN") // KITCHEN, SALON, ADMIN
  isActive     Boolean  @default(true)
  cloverEmployeeId String? @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  prepAssignments      PrepAssignment[]
  completedAssignments PrepAssignmentCompletedBy[]
  tipEntries           TipShiftEntry[]
}

model Provider {
  id          String       @id @default(cuid())
  name        String
  ingredients Ingredient[]
}

model Category {
  id             String          @id @default(cuid())
  name           String
  nameEs         String?
  type           String          @default("INGREDIENT") // INGREDIENT, TASK, RECIPE
  autoTranslate  Boolean         @default(true)
  department     String // FOOD, DRINKS, CLEANING
  cookAssignment Int?            @default(1) // 1 or 2
  ingredients    Ingredient[]
  digitalRecipes DigitalRecipe[]
}

model Ingredient {
  id             String    @id @default(cuid())
  name           String    @unique
  nameEs         String?
  autoTranslate  Boolean   @default(true)
  type           String // RAW, PROCESSED
  categoryId     String
  category       Category  @relation(fields: [categoryId], references: [id])
  providerId     String?
  provider       Provider? @relation(fields: [providerId], references: [id])
  portionWeightG Float     @default(1000.0)
  metric         String    @default("units")
  currentPrice   Float     @default(0.0)
  yieldPercent   Float     @default(100.0)
  aliases        String? // JSON string
  trackFreezerStatus Boolean @default(false)
  unfrozenQuantity Float @default(0)
  allowNegativeStock Boolean @default(true)
  subtractFromInventory Boolean @default(false)
  cookAssignmentOverride Int? // null = inherit from category
  
  isPacked       Boolean @default(false)
  unitsPerPack   Float   @default(1.0)
  packUnit       String  @default("Units")
  packsInBox     Float?
  totalBoxPrice  Float?
  needsOrdering  Boolean @default(false)
  isSubmittedForOrdering Boolean @default(false)
  purchaseStatus String  @default("PENDIENTE")   // PENDIENTE | COMPRADO | NO_DISPONIBLE
  carriedOver    Boolean @default(false)
  isActive       Boolean @default(true)           // soft-disable: false = hidden from cook-facing lists
  isSalonItem    Boolean @default(false)
  showInKitchen  Boolean @default(true)
  esfuerzo       String  @default("MANUAL")       // MANUAL | HERVIDO
  updatedAt      DateTime  @default(now()) @updatedAt

  parentId  String?
  parent    Ingredient?  @relation("IngredientToPrep", fields: [parentId], references: [id])
  prepItems Ingredient[] @relation("IngredientToPrep")

  inventory         Inventory?
  salonStock        SalonStock?
  salonRestocks     SalonRestock[]
  transactions      InventoryTransaction[]
  recipeIngredients RecipeIngredient[]
  prepAssignments   PrepAssignment[]
  vendorMarketItems VendorMarketItem[]
  
  // Rules
  isRuleTarget    RecurringPrepRule[] @relation("RuleTarget")
  isRuleBase      RecurringPrepRule[] @relation("RuleBase")
  prepRules       PrepRule[]

  composedOf  PrepRecipeIngredient[] @relation("RecipeComposedOf")
  usedInPreps PrepRecipeIngredient[] @relation("UsedInPreps")

  activeMarketItemId String?
  activeMarketItem   VendorMarketItem?    @relation("ActiveMarketItem", fields: [activeMarketItemId], references: [id])
  cloverId           String?
  mappingMultiplier  Float                @default(1.0)
  ModifierIngredient ModifierIngredient[]

  digitalRecipeId    String?
  digitalRecipe      DigitalRecipe?       @relation("IngredientToDigitalRecipe", fields: [digitalRecipeId], references: [id])
}

model SalonStock {
  id               String     @id @default(cuid())
  ingredientId     String     @unique
  ingredient       Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  qtyFront         Int        @default(0)
  qtyBodega        Int        @default(0)
  parFront         Int        @default(0)
  unitsPerPack     Int        @default(24)
  salePrice        Int        @default(0)   // sell price in integer cents, mirrors Clover's price format
  salonGroup       String     @default("Refrescos")   // display grouping in the salon inventory table
  autoManage       Boolean    @default(true)   // Clover auto-decrements stock on sale
  cloverItemId     String?
  lastCloverSyncAt DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
}

model SalonStaffVisibility {
  id        String   @id @default(cuid())
  cloverId  String   @unique
  name      String
  isVisible Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

model SalonGroup {
  id        String   @id @default(cuid())
  name      String   @unique
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model SalonRestock {
  id             String   @id @default(cuid())
  ingredientId   String
  ingredient     Ingredient @relation(fields: [ingredientId], references: [id])
  quantity       Int
  qtyFrontBefore Int
  qtyFrontAfter  Int
  qtyBodegaBefore Int
  qtyBodegaAfter Int
  employeeId     String?
  employeeName   String?
  createdAt      DateTime @default(now())
}

model ProcessedCloverLineItem {
  id               String   @id @default(cuid())
  cloverLineItemId String   @unique
  orderId          String
  processedAt      DateTime @default(now())

  itemName     String?
  categoryName String?
  createdTime  DateTime @default(now())
  qty          Int      @default(1)

  modifiers ProcessedCloverModifier[]
}

model ProcessedCloverModifier {
  id               String                  @id @default(cuid())
  cloverModifierId String                  @unique
  lineItemId       String
  lineItem         ProcessedCloverLineItem @relation(fields: [lineItemId], references: [id], onDelete: Cascade)
  modifierName     String?
  qty              Int                     @default(1)
}

model VendorMarketItem {
  id                 String     @id @default(cuid())
  ingredientId       String
  ingredient         Ingredient @relation(fields: [ingredientId], references: [id])
  vendorName         String?
  invoiceDescription String
  packSize           Float
  packUnit           String
  currentPackPrice   Float
  lastPurchasedDate  DateTime?
  culinaryNotes      String?
  isPreferredVendor  Boolean    @default(false)

  // Reverse relation for activeMarketItem
  activeForIngredients Ingredient[] @relation("ActiveMarketItem")
}

model MenuCategory {
  id        String   @id @default(cuid())
  nameEn    String
  nameEs    String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  menuItems MenuItem[]
}

model MenuItem {
  id                    String  @id @default(cuid())
  name                  String  @unique
  category              String? // Ceviches, Appetizers, Entrees, Sauces
  salePrice             Float   @default(0.0)
  targetFoodCostPct     Float   @default(25.0)
  cloverId              String? // Integration point: Clover POS item id (menu <-> POS sync)
  hasInventoryModifiers Boolean @default(false)

  // Digital menu module — additive fields only (all optional/defaulted)
  nameEs          String?
  descriptionEn   String?
  descriptionEs   String?
  photoUrl        String?
  photoUrls       String[] @default([]) // gallery photos for the lightbox; photoUrl remains the card cover
  photoFocalX     Int      @default(50) // cover focal point X as 0-100 %, drives object-position crop on the public menu
  photoFocalY     Int      @default(50) // cover focal point Y as 0-100 %
  photoZoom       Int      @default(100) // favorites-band cover zoom, 100-300 % (image width/height, no transform)
  photoFit        String   @default("cover") // favorites-band fit: "cover" (fill+crop) or "contain" (whole photo on textile backdrop)
  videoUrl        String?
  taglineEn       String? // short catchy "how we make it" line, shown in the lightbox (max 60 chars, enforced in menuAdmin actions)
  taglineEs       String?
  isAvailable     Boolean @default(true)
  isFeatured      Boolean @default(false)
  featuredRank    Int?    // "most ordered" band on the public menu: lower rank shows first (null = not featured)
  sortOrder       Int     @default(0)
  menuCategoryId  String? // Integration point: digital menu category (menu module)
  menuCategory    MenuCategory? @relation(fields: [menuCategoryId], references: [id])
  digitalRecipeId String? // Integration point: Recetario link for food-cost reporting
  digitalRecipe   DigitalRecipe? @relation(fields: [digitalRecipeId], references: [id])

  recipeIngredients RecipeIngredient[]
  modifiers         MenuItemModifier[]
}

model MenuItemModifier {
  id               String @id @default(cuid())
  menuItemId       String
  name             String
  cloverModifierId String

  menuItem    MenuItem             @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  ingredients ModifierIngredient[]
}

model ModifierIngredient {
  id           String  @id @default(cuid())
  modifierId   String
  ingredientId String
  quantity     Float
  unit         String?

  modifier   MenuItemModifier @relation(fields: [modifierId], references: [id], onDelete: Cascade)
  ingredient Ingredient       @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
}

model RecipeIngredient {
  id           String  @id @default(cuid())
  menuItemId   String
  ingredientId String
  quantity     Float
  unit         String?

  menuItem   MenuItem   @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
}

model PrepRecipeIngredient {
  id           String  @id @default(cuid())
  prepRecipeId String
  ingredientId String
  quantity     Float
  unit         String?
  groupName    String?

  prepRecipe Ingredient @relation("RecipeComposedOf", fields: [prepRecipeId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation("UsedInPreps", fields: [ingredientId], references: [id], onDelete: Restrict)
}

model Inventory {
  id           String     @id @default(cuid())
  ingredientId String     @unique
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  frozenQty    Float      @default(0.0)
  thawingQty   Float      @default(0.0)
}

model InventoryTransaction {
  id           String     @id @default(cuid())
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  type         String // DEDUCT_FROZEN, ADD_THAWING, SALES_DEDUCT, PULL_PREP
  qty          Float
  note         String?
  createdAt    DateTime   @default(now())
}

model DailySales {
  id           String   @id @default(cuid())
  date         DateTime
  itemName     String
  modification String?
  qtySOLD      Float
  price        Float
  processedAt  DateTime @default(now())
}

model Schedule {
  id         String   @id @default(cuid())
  date       DateTime
  createdBy  String
  assignedTo String
  notes      String?

  prepAssignments PrepAssignment[]
}

model PrepAssignment {
  id               String    @id @default(cuid())
  scheduleId       String
  userId           String
  ingredientId     String
  portionsAssigned Float
  portionsActual   Float?
  completed        Boolean   @default(false)
  completedAt      DateTime?
  isUrgent         Boolean   @default(false)

  schedule        Schedule                    @relation(fields: [scheduleId], references: [id])
  user            User                        @relation(fields: [userId], references: [id])
  ingredient      Ingredient                  @relation(fields: [ingredientId], references: [id])
  completedByCooks PrepAssignmentCompletedBy[]
}

model DropdownOption {
  id           String   @id @default(cuid())
  group        String // Category, Type, Metric
  name         String
  nameEs       String?
  isTranslated Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model RecurringPrepRule {
  id               String @id @default(cuid())
  ingredientId     String
  baseIngredientId String?
  dayOfWeek        Int // 0=Sun, 1=Mon, 2=Tue, 3=Wed, 4=Thu, 5=Fri, 6=Sat
  amount           Float // Represents Total Demand
  mode             String @default("MANUAL") // MANUAL or ALGORITHM

  ingredient     Ingredient @relation("RuleTarget", fields: [ingredientId], references: [id])
  baseIngredient Ingredient? @relation("RuleBase", fields: [baseIngredientId], references: [id])

  @@unique([ingredientId, dayOfWeek])
}

model PrepRule {
  id                 String     @id @default(cuid())
  ingredientId       String
  ingredient         Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  ruleType           String     @default("REGULAR") // REGULAR, EMERGENCY
  activeDays         Int[]      // Days of the week task appears (0-6)
  calculationMode    String     @default("ALGORITHM") // ALGORITHM, MANUAL
  fixedAmount        Float?
  coverageDays       Int[]      // Array of days it covers (0-6)
  emergencyDays      Int        @default(3)
  emergencyThreshold Float      @default(1.5)
  triggerThreshold   Float?
}

model DigitalRecipe {
  id              String   @id @default(cuid())
  type            String   // RECIPE, PLATING, GUIDE
  recipeCode      String   @unique
  name            String
  nameEs          String?
  yield           String?
  overview        String?
  ingredientsJson String?  // JSON text: [{ id, ingredient, quantity, metric, notes }]
  procedureJson   String?  // JSON text: array of steps/strings
  platingTracksJson String? // JSON text: { tracks: [], rows: [] }
  mediaJson       String?  // JSON text: final plated photo url
  chefNotes       String?
  revisionDate    DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  categoryId      String?
  category        Category? @relation(fields: [categoryId], references: [id])

  history         DigitalRecipeHistory[]
  linkedTasks     Ingredient[] @relation("IngredientToDigitalRecipe")
  menuItems       MenuItem[]
}

model DigitalRecipeHistory {
  id              String   @id @default(cuid())
  recipeId        String
  recipe          DigitalRecipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  type            String
  recipeCode      String
  name            String
  nameEs          String?
  yield           String?
  overview        String?
  ingredientsJson String?
  procedureJson   String?
  platingTracksJson String?
  mediaJson       String?
  chefNotes       String?
  revisionDate    DateTime
  savedAt         DateTime @default(now())
  savedBy         String?
}

model PrepAssignmentCompletedBy {
  id           String         @id @default(cuid())
  assignmentId String
  userId       String
  createdAt    DateTime       @default(now())
  assignment   PrepAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  user         User           @relation(fields: [userId], references: [id])

  @@unique([assignmentId, userId])
}

// ─────────────────────────────────────────────────────────────
// QuickBooks Online sync models
// Design: one flattened fact table (QboTransactionLine) with
// denormalized account attributes, so both the in-app pivot and
// Power BI can aggregate without joins.
// ─────────────────────────────────────────────────────────────

model QboConnection {
  id                    String   @id @default(cuid())
  realmId               String   @unique
  accessToken           String
  refreshToken          String
  accessTokenExpiresAt  DateTime
  refreshTokenExpiresAt DateTime
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model QboAccount {
  id                 String   @id // QBO Account.Id
  name               String
  fullyQualifiedName String?
  accountType        String? // e.g. "Expense", "Cost of Goods Sold", "Income"
  accountSubType     String?
  classification     String? // Asset | Liability | Equity | Revenue | Expense
  active             Boolean  @default(true)
  syncedAt           DateTime @updatedAt
}

model QboVendor {
  id          String   @id
  displayName String
  active      Boolean  @default(true)
  syncedAt    DateTime @updatedAt
}

/// One row per transaction line across Purchase, Bill, Invoice,
/// JournalEntry. This is the pivot/Power BI fact table.
model QboTransactionLine {
  id             String   @id // `${txnType}:${txnId}:${lineIndex}`
  txnId          String
  txnType        String // Purchase | Bill | Invoice | JournalEntry
  txnDate        DateTime @db.Date
  docNumber      String?
  accountId      String?
  accountName    String? // denormalized for pivoting
  accountType    String? // denormalized
  classification String? // denormalized: Revenue / Expense / etc.
  entityName     String? // vendor (expenses) or customer (income)
  memo           String?
  amount         Decimal  @db.Decimal(14, 2) // signed: expenses +, credits -
  postingType    String? // Debit | Credit (journal entries only)
  syncedAt       DateTime @updatedAt

  @@index([txnDate])
  @@index([accountName])
  @@index([entityName])
  @@index([txnType])
}

model QboSyncState {
  id             String    @id @default("singleton")
  lastCdcAt      DateTime? // watermark for Change Data Capture
  fullSyncDoneAt DateTime?
  lastRunStatus  String?
  updatedAt      DateTime  @updatedAt
}

model ShiftSection {
  id        String  @id @default(cuid())
  listType  String              // APERTURA | CIERRE | LIMPIEZA
  name      String
  dayOfWeek Int?                // LIMPIEZA only: 1=Lunes .. 4=Jueves
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)
  tasks     ShiftTask[]
}

model ShiftTask {
  id         String  @id @default(cuid())
  sectionId  String
  section    ShiftSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  text       String
  daysOfWeek String?            // comma ISO days e.g. "4,7". null = every day
  sortOrder  Int     @default(0)
  isActive   Boolean @default(true)
  checks     ShiftTaskCheck[]
  deferrals  ShiftDeferral[]
}

model ShiftRun {
  id               String    @id @default(cuid())
  listType         String
  businessDate     String    // YYYY-MM-DD
  completedAt      DateTime?
  shareAttemptedAt DateTime?
  createdAt        DateTime  @default(now())
  checks           ShiftTaskCheck[]
  staff            ShiftRunStaff[]
  deferrals        ShiftDeferral[]
  @@unique([listType, businessDate])
}

model ShiftRunStaff {
  id           String   @id @default(cuid())
  runId        String
  run          ShiftRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  sectionId    String
  employeeId   String
  employeeName String
  @@unique([runId, sectionId, employeeId])
}

model ShiftTaskCheck {
  id        String    @id @default(cuid())
  runId     String
  run       ShiftRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  taskId    String
  task      ShiftTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  checkedAt DateTime  @default(now())
  @@unique([runId, taskId])
}

model ShiftDeferral {
  id          String    @id @default(cuid())
  taskId      String
  task        ShiftTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  runId       String
  run         ShiftRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  reason      String
  plannedFor  String    // ESTA_NOCHE | PROXIMA_APERTURA
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())
}

// ─────────────────────────────────────────────────────────────
// Daily tip distribution
// Worker identity is the Clover employeeId string, matching
// ShiftRunStaff and SalonRestock. TipShiftEntry.userId is an
// optional bridge to User for future payroll rollup.
// ─────────────────────────────────────────────────────────────

enum TipDayStatus {
  BORRADOR
  ENVIADO
}

enum TipEntryRole {
  MESERO
  BUSSER
}

enum TipTargetField {
  CREDIT_TIPS
  SERVICE_CHARGE
  CASH_TIPS
  ENTRY_ADJUSTMENT
  SUBMISSION_REOPENED
}

model TipDay {
  id                    String              @id @default(cuid())
  businessDate          DateTime            @unique @db.Date
  cloverCreditTips      Decimal?            @db.Decimal(10,2)
  cloverServiceCharge   Decimal?            @db.Decimal(10,2)
  cloverCashTips        Decimal?            @db.Decimal(10,2)
  cloverSyncedAt        DateTime?
  // What the last sync did. Diagnostics for a run that came back wrong, not
  // figures anyone is paid from.
  cloverSyncDurationMs  Int?
  cloverOrdersScanned   Int?
  cloverPaymentsScanned Int?
  totalCreditTips       Decimal             @db.Decimal(10,2) @default(0)
  totalServiceCharge    Decimal             @db.Decimal(10,2) @default(0)
  totalCashTips         Decimal             @db.Decimal(10,2) @default(0)
  status                TipDayStatus        @default(BORRADOR)
  submittedAt           DateTime?
  submittedByCloverId   String?
  submittedByName       String?
  shifts                TipShift[]
  overrides             TipTargetOverride[]
  employeeTips          TipDayEmployeeTip[]
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  @@index([businessDate])
}

model TipTargetOverride {
  id                String         @id @default(cuid())
  tipDayId          String
  tipDay            TipDay         @relation(fields: [tipDayId], references: [id], onDelete: Cascade)
  // Set for entry-level adjustments, null for day-level ones. SetNull rather
  // than Cascade on purpose: deleting an entry must not erase the record that
  // it was changed.
  entryId           String?
  entry             TipShiftEntry? @relation(fields: [entryId], references: [id], onDelete: SetNull)
  field             TipTargetField
  previousValue     Decimal        @db.Decimal(10,2)
  newValue          Decimal        @db.Decimal(10,2)
  reason            String?
  changedByCloverId String
  changedByName     String
  createdAt         DateTime       @default(now())
  @@index([tipDayId])
  @@index([entryId])
}

model TipShift {
  id               String          @id @default(cuid())
  tipDayId         String
  tipDay           TipDay          @relation(fields: [tipDayId], references: [id], onDelete: Cascade)
  orderIndex       Int
  entries          TipShiftEntry[]
  filledByCloverId String?
  filledByName     String?
  filledAt         DateTime?
  createdAt        DateTime        @default(now())
  @@unique([tipDayId, orderIndex])
}

model TipShiftEntry {
  id                          String       @id @default(cuid())
  tipShiftId                  String
  tipShift                    TipShift     @relation(fields: [tipShiftId], references: [id], onDelete: Cascade)
  cloverEmployeeId            String
  employeeName                String
  userId                      String?
  user                        User?        @relation(fields: [userId], references: [id])
  role                        TipEntryRole
  creditTips                  Decimal      @db.Decimal(10,2) @default(0)
  serviceCharge               Decimal      @db.Decimal(10,2) @default(0)
  cashTips                    Decimal?     @db.Decimal(10,2)
  cashZeroConfirmedByCloverId String?
  cashZeroConfirmedByName     String?
  cashZeroConfirmedAt         DateTime?
  overrides                   TipTargetOverride[]
  createdAt                   DateTime     @default(now())
  updatedAt                   DateTime     @updatedAt
  @@unique([tipShiftId, cloverEmployeeId])
  @@index([cloverEmployeeId])
  @@index([userId])
}

// A cache of what Clover reported per employee, refreshed wholesale on every
// sync. It is never edited by hand and it is NOT the authoritative
// distribution — TipShiftEntry is, and stays so. Nothing here is what anyone is
// owed; it exists to be compared against what the staff entered.
model TipDayEmployeeTip {
  id               String   @id @default(cuid())
  tipDayId         String
  tipDay           TipDay   @relation(fields: [tipDayId], references: [id], onDelete: Cascade)
  cloverEmployeeId String
  employeeName     String
  paymentCount     Int      @default(0)
  cardTips         Decimal  @db.Decimal(10,2) @default(0)
  serviceCharge    Decimal  @db.Decimal(10,2) @default(0)
  salesAmount      Decimal  @db.Decimal(10,2) @default(0)
  syncedAt         DateTime @default(now())
  @@unique([tipDayId, cloverEmployeeId])
  @@index([tipDayId])
}

// ─────────────────────────────────────────────────────────────
// Weekly payroll and retention
// Worker identity is the Clover employeeId string, as in the tip
// models. PayrollEntry.role reuses TipEntryRole rather than
// declaring a second copy of the same two roles.
// ─────────────────────────────────────────────────────────────

enum PayrollWeekStatus {
  BORRADOR
  CERRADO
}

enum RetentionKind {
  RETENCION
  ENTREGA
}

model PayrollRateConfig {
  id            String   @id @default("singleton")
  serverRate    Decimal  @db.Decimal(6,2)
  busserRate    Decimal  @db.Decimal(6,2)
  minimumWage   Decimal  @db.Decimal(6,2)
  cushionAmount Decimal  @db.Decimal(6,2) @default(0)
  updatedAt     DateTime @updatedAt
}

model PayrollWeek {
  id            String            @id @default(cuid())
  weekEnding    DateTime          @unique @db.Date
  status        PayrollWeekStatus @default(BORRADOR)
  hoursSyncedAt DateTime?
  entries       PayrollEntry[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  @@index([weekEnding])
}

model PayrollEntry {
  id               String       @id @default(cuid())
  payrollWeekId    String
  payrollWeek      PayrollWeek  @relation(fields: [payrollWeekId], references: [id], onDelete: Cascade)
  cloverEmployeeId String
  employeeName     String
  role             TipEntryRole
  hoursWorked      Decimal      @db.Decimal(7,2) @default(0)
  hourlyRate       Decimal      @db.Decimal(6,2) @default(0)
  tipsTotal        Decimal      @db.Decimal(10,2) @default(0)
  adpTips          Decimal      @db.Decimal(10,2) @default(0)
  checkTips        Decimal      @db.Decimal(10,2) @default(0)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  @@unique([payrollWeekId, cloverEmployeeId])
  @@index([cloverEmployeeId])
}

model RetentionSetting {
  cloverEmployeeId String   @id
  employeeName     String
  isActive         Boolean  @default(false)
  percentage       Decimal  @db.Decimal(5,2) @default(0)
  updatedAt        DateTime @updatedAt
}

// Signed ledger. amount is ALWAYS stored positive; kind carries the direction.
// A RETENCION is money held, an ENTREGA is money paid back out in their name,
// so the balance held is the sum of RETENCION minus the sum of ENTREGA — any
// query that adds the rows without subtracting ENTREGA reports the wrong
// figure. The balance is never stored: a running total that can be edited
// independently of the rows that produced it will drift.
// payrollWeekId is a loose reference with no relation, deliberately — deleting
// a week must not cascade away the record of money held.
model RetentionLedger {
  id               String        @id @default(cuid())
  cloverEmployeeId String
  employeeName     String
  kind             RetentionKind
  amount           Decimal       @db.Decimal(10,2)
  percentageUsed   Decimal?      @db.Decimal(5,2)
  payrollWeekId    String?
  note             String?
  recordedByName   String?
  createdAt        DateTime      @default(now())
  @@index([cloverEmployeeId])
  @@index([payrollWeekId])
}

// ─────────────────────────────────────────────────────────────
// Imported timesheet punches
// ─────────────────────────────────────────────────────────────

enum PunchSource {
  IMPORTADO
  MANUAL
}

// One clock-in/clock-out pair, as recorded by the time clock.
//
// Worker identity here is the NAME as the timesheet export gives it, because
// the export carries no employee id. cloverEmployeeId is resolved on import
// where the name matches the Clover roster and left null where it does not —
// an unmatched name is surfaced at import time, never silently dropped.
//
// businessDate is derived from clockIn under the 5 AM cutover, so a shift that
// ends after midnight belongs entirely to the evening it started.
model PayrollPunch {
  id               String      @id @default(cuid())
  businessDate     DateTime    @db.Date
  employeeName     String
  cloverEmployeeId String?
  clockIn          DateTime
  clockOut         DateTime?
  hours            Decimal     @db.Decimal(7,2) @default(0)
  source           PunchSource @default(IMPORTADO)
  isFlagged        Boolean     @default(false)
  flagReason       String?
  importBatchId    String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  @@index([businessDate])
  @@index([employeeName])
  @@index([cloverEmployeeId])
  @@index([importBatchId])
}
