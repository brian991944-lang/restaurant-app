// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String?
  email        String?  @unique
  passwordHash String?
  role         String   @default("KITCHEN") // KITCHEN, SALON, ADMIN
  isActive     Boolean  @default(true)
  cloverEmployeeId String? @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  prepAssignments      PrepAssignment[]
  completedAssignments PrepAssignmentCompletedBy[]
  tipEntries           TipShiftEntry[]
}

model Provider {
  id          String       @id @default(cuid())
  name        String
  ingredients Ingredient[]
}

model Category {
  id             String          @id @default(cuid())
  name           String
  nameEs         String?
  type           String          @default("INGREDIENT") // INGREDIENT, TASK, RECIPE
  autoTranslate  Boolean         @default(true)
  department     String // FOOD, DRINKS, CLEANING
  cookAssignment Int?            @default(1) // 1 or 2
  ingredients    Ingredient[]
  digitalRecipes DigitalRecipe[]
}

model Ingredient {
  id             String    @id @default(cuid())
  name           String    @unique
  nameEs         String?
  autoTranslate  Boolean   @default(true)
  type           String // RAW, PROCESSED
  categoryId     String
  category       Category  @relation(fields: [categoryId], references: [id])
  providerId     String?
  provider       Provider? @relation(fields: [providerId], references: [id])
  portionWeightG Float     @default(1000.0)
  metric         String    @default("units")
  currentPrice   Float     @default(0.0)
  yieldPercent   Float     @default(100.0)
  aliases        String? // JSON string
  trackFreezerStatus Boolean @default(false)
  unfrozenQuantity Float @default(0)
  allowNegativeStock Boolean @default(true)
  subtractFromInventory Boolean @default(false)
  cookAssignmentOverride Int? // null = inherit from category
  
  isPacked       Boolean @default(false)
  unitsPerPack   Float   @default(1.0)
  packUnit       String  @default("Units")
  packsInBox     Float?
  totalBoxPrice  Float?
  needsOrdering  Boolean @default(false)
  isSubmittedForOrdering Boolean @default(false)
  purchaseStatus String  @default("PENDIENTE")   // PENDIENTE | COMPRADO | NO_DISPONIBLE
  carriedOver    Boolean @default(false)
  isActive       Boolean @default(true)           // soft-disable: false = hidden from cook-facing lists
  isSalonItem    Boolean @default(false)
  showInKitchen  Boolean @default(true)
  esfuerzo       String  @default("MANUAL")       // MANUAL | HERVIDO
  updatedAt      DateTime  @default(now()) @updatedAt

  parentId  String?
  parent    Ingredient?  @relation("IngredientToPrep", fields: [parentId], references: [id])
  prepItems Ingredient[] @relation("IngredientToPrep")

  inventory         Inventory?
  salonStock        SalonStock?
  salonRestocks     SalonRestock[]
  transactions      InventoryTransaction[]
  recipeIngredients RecipeIngredient[]
  prepAssignments   PrepAssignment[]
  vendorMarketItems VendorMarketItem[]
  
  // Rules
  isRuleTarget    RecurringPrepRule[] @relation("RuleTarget")
  isRuleBase      RecurringPrepRule[] @relation("RuleBase")
  prepRules       PrepRule[]

  composedOf  PrepRecipeIngredient[] @relation("RecipeComposedOf")
  usedInPreps PrepRecipeIngredient[] @relation("UsedInPreps")

  activeMarketItemId String?
  activeMarketItem   VendorMarketItem?    @relation("ActiveMarketItem", fields: [activeMarketItemId], references: [id])
  cloverId           String?
  mappingMultiplier  Float                @default(1.0)
  ModifierIngredient ModifierIngredient[]

  digitalRecipeId    String?
  digitalRecipe      DigitalRecipe?       @relation("IngredientToDigitalRecipe", fields: [digitalRecipeId], references: [id])
}

model SalonStock {
  id               String     @id @default(cuid())
  ingredientId     String     @unique
  ingredient       Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  qtyFront         Int        @default(0)
  qtyBodega        Int        @default(0)
  parFront         Int        @default(0)
  unitsPerPack     Int        @default(24)
  salePrice        Int        @default(0)   // sell price in integer cents, mirrors Clover's price format
  salonGroup       String     @default("Refrescos")   // display grouping in the salon inventory table
  autoManage       Boolean    @default(true)   // Clover auto-decrements stock on sale
  cloverItemId     String?
  lastCloverSyncAt DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
}

model SalonStaffVisibility {
  id        String   @id @default(cuid())
  cloverId  String   @unique
  name      String
  isVisible Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

model SalonGroup {
  id        String   @id @default(cuid())
  name      String   @unique
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model SalonRestock {
  id             String   @id @default(cuid())
  ingredientId   String
  ingredient     Ingredient @relation(fields: [ingredientId], references: [id])
  quantity       Int
  qtyFrontBefore Int
  qtyFrontAfter  Int
  qtyBodegaBefore Int
  qtyBodegaAfter Int
  employeeId     String?
  employeeName   String?
  createdAt      DateTime @default(now())
}

model ProcessedCloverLineItem {
  id               String   @id @default(cuid())
  cloverLineItemId String   @unique
  orderId          String
  processedAt      DateTime @default(now())

  itemName     String?
  categoryName String?
  createdTime  DateTime @default(now())
  qty          Int      @default(1)

  modifiers ProcessedCloverModifier[]
}

model ProcessedCloverModifier {
  id               String                  @id @default(cuid())
  cloverModifierId String                  @unique
  lineItemId       String
  lineItem         ProcessedCloverLineItem @relation(fields: [lineItemId], references: [id], onDelete: Cascade)
  modifierName     String?
  qty              Int                     @default(1)
}

model VendorMarketItem {
  id                 String     @id @default(cuid())
  ingredientId       String
  ingredient         Ingredient @relation(fields: [ingredientId], references: [id])
  vendorName         String?
  invoiceDescription String
  packSize           Float
  packUnit           String
  currentPackPrice   Float
  lastPurchasedDate  DateTime?
  culinaryNotes      String?
  isPreferredVendor  Boolean    @default(false)

  // Reverse relation for activeMarketItem
  activeForIngredients Ingredient[] @relation("ActiveMarketItem")
}

model MenuCategory {
  id        String   @id @default(cuid())
  nameEn    String
  nameEs    String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  menuItems MenuItem[]
}

model MenuItem {
  id                    String  @id @default(cuid())
  name                  String  @unique
  category              String? // Ceviches, Appetizers, Entrees, Sauces
  salePrice             Float   @default(0.0)
  targetFoodCostPct     Float   @default(25.0)
  cloverId              String? // Integration point: Clover POS item id (menu <-> POS sync)
  hasInventoryModifiers Boolean @default(false)

  // Digital menu module — additive fields only (all optional/defaulted)
  nameEs          String?
  descriptionEn   String?
  descriptionEs   String?
  photoUrl        String?
  photoUrls       String[] @default([]) // gallery photos for the lightbox; photoUrl remains the card cover
  photoFocalX     Int      @default(50) // cover focal point X as 0-100 %, drives object-position crop on the public menu
  photoFocalY     Int      @default(50) // cover focal point Y as 0-100 %
  photoZoom       Int      @default(100) // favorites-band cover zoom, 100-300 % (image width/height, no transform)
  photoFit        String   @default("cover") // favorites-band fit: "cover" (fill+crop) or "contain" (whole photo on textile backdrop)
  videoUrl        String?
  taglineEn       String? // short catchy "how we make it" line, shown in the lightbox (max 60 chars, enforced in menuAdmin actions)
  taglineEs       String?
  isAvailable     Boolean @default(true)
  isFeatured      Boolean @default(false)
  featuredRank    Int?    // "most ordered" band on the public menu: lower rank shows first (null = not featured)
  sortOrder       Int     @default(0)
  menuCategoryId  String? // Integration point: digital menu category (menu module)
  menuCategory    MenuCategory? @relation(fields: [menuCategoryId], references: [id])
  digitalRecipeId String? // Integration point: Recetario link for food-cost reporting
  digitalRecipe   DigitalRecipe? @relation(fields: [digitalRecipeId], references: [id])

  recipeIngredients RecipeIngredient[]
  modifiers         MenuItemModifier[]
}

model MenuItemModifier {
  id               String @id @default(cuid())
  menuItemId       String
  name             String
  cloverModifierId String

  menuItem    MenuItem             @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  ingredients ModifierIngredient[]
}

model ModifierIngredient {
  id           String  @id @default(cuid())
  modifierId   String
  ingredientId String
  quantity     Float
  unit         String?

  modifier   MenuItemModifier @relation(fields: [modifierId], references: [id], onDelete: Cascade)
  ingredient Ingredient       @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
}

model RecipeIngredient {
  id           String  @id @default(cuid())
  menuItemId   String
  ingredientId String
  quantity     Float
  unit         String?

  menuItem   MenuItem   @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
}

model PrepRecipeIngredient {
  id           String  @id @default(cuid())
  prepRecipeId String
  ingredientId String
  quantity     Float
  unit         String?
  groupName    String?

  prepRecipe Ingredient @relation("RecipeComposedOf", fields: [prepRecipeId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation("UsedInPreps", fields: [ingredientId], references: [id], onDelete: Restrict)
}

model Inventory {
  id           String     @id @default(cuid())
  ingredientId String     @unique
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  frozenQty    Float      @default(0.0)
  thawingQty   Float      @default(0.0)
}

model InventoryTransaction {
  id           String     @id @default(cuid())
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  type         String // DEDUCT_FROZEN, ADD_THAWING, SALES_DEDUCT, PULL_PREP
  qty          Float
  note         String?
  createdAt    DateTime   @default(now())
}

model DailySales {
  id           String   @id @default(cuid())
  date         DateTime
  itemName     String
  modification String?
  qtySOLD      Float
  price        Float
  processedAt  DateTime @default(now())
}

model Schedule {
  id         String   @id @default(cuid())
  date       DateTime
  createdBy  String
  assignedTo String
  notes      String?

  prepAssignments PrepAssignment[]
}

model PrepAssignment {
  id               String    @id @default(cuid())
  scheduleId       String
  userId           String
  ingredientId     String
  portionsAssigned Float
  portionsActual   Float?
  completed        Boolean   @default(false)
  completedAt      DateTime?
  isUrgent         Boolean   @default(false)

  schedule        Schedule                    @relation(fields: [scheduleId], references: [id])
  user            User                        @relation(fields: [userId], references: [id])
  ingredient      Ingredient                  @relation(fields: [ingredientId], references: [id])
  completedByCooks PrepAssignmentCompletedBy[]
}

model DropdownOption {
  id           String   @id @default(cuid())
  group        String // Category, Type, Metric
  name         String
  nameEs       String?
  isTranslated Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model RecurringPrepRule {
  id               String @id @default(cuid())
  ingredientId     String
  baseIngredientId String?
  dayOfWeek        Int // 0=Sun, 1=Mon, 2=Tue, 3=Wed, 4=Thu, 5=Fri, 6=Sat
  amount           Float // Represents Total Demand
  mode             String @default("MANUAL") // MANUAL or ALGORITHM

  ingredient     Ingredient @relation("RuleTarget", fields: [ingredientId], references: [id])
  baseIngredient Ingredient? @relation("RuleBase", fields: [baseIngredientId], references: [id])

  @@unique([ingredientId, dayOfWeek])
}

model PrepRule {
  id                 String     @id @default(cuid())
  ingredientId       String
  ingredient         Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  ruleType           String     @default("REGULAR") // REGULAR, EMERGENCY
  activeDays         Int[]      // Days of the week task appears (0-6)
  calculationMode    String     @default("ALGORITHM") // ALGORITHM, MANUAL
  fixedAmount        Float?
  coverageDays       Int[]      // Array of days it covers (0-6)
  emergencyDays      Int        @default(3)
  emergencyThreshold Float      @default(1.5)
  triggerThreshold   Float?
}

model DigitalRecipe {
  id              String   @id @default(cuid())
  type            String   // RECIPE, PLATING, GUIDE
  recipeCode      String   @unique
  name            String
  nameEs          String?
  yield           String?
  overview        String?
  ingredientsJson String?  // JSON text: [{ id, ingredient, quantity, metric, notes }]
  procedureJson   String?  // JSON text: array of steps/strings
  platingTracksJson String? // JSON text: { tracks: [], rows: [] }
  mediaJson       String?  // JSON text: final plated photo url
  chefNotes       String?
  revisionDate    DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  categoryId      String?
  category        Category? @relation(fields: [categoryId], references: [id])

  history         DigitalRecipeHistory[]
  linkedTasks     Ingredient[] @relation("IngredientToDigitalRecipe")
  menuItems       MenuItem[]
}

model DigitalRecipeHistory {
  id              String   @id @default(cuid())
  recipeId        String
  recipe          DigitalRecipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  type            String
  recipeCode      String
  name            String
  nameEs          String?
  yield           String?
  overview        String?
  ingredientsJson String?
  procedureJson   String?
  platingTracksJson String?
  mediaJson       String?
  chefNotes       String?
  revisionDate    DateTime
  savedAt         DateTime @default(now())
  savedBy         String?
}

model PrepAssignmentCompletedBy {
  id           String         @id @default(cuid())
  assignmentId String
  userId       String
  createdAt    DateTime       @default(now())
  assignment   PrepAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  user         User           @relation(fields: [userId], references: [id])

  @@unique([assignmentId, userId])
}

// ─────────────────────────────────────────────────────────────
// QuickBooks Online sync models
// Design: one flattened fact table (QboTransactionLine) with
// denormalized account attributes, so both the in-app pivot and
// Power BI can aggregate without joins.
// ─────────────────────────────────────────────────────────────

model QboConnection {
  id                    String   @id @default(cuid())
  realmId               String   @unique
  accessToken           String
  refreshToken          String
  accessTokenExpiresAt  DateTime
  refreshTokenExpiresAt DateTime
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model QboAccount {
  id                 String   @id // QBO Account.Id
  name               String
  fullyQualifiedName String?
  accountType        String? // e.g. "Expense", "Cost of Goods Sold", "Income"
  accountSubType     String?
  classification     String? // Asset | Liability | Equity | Revenue | Expense
  active             Boolean  @default(true)
  syncedAt           DateTime @updatedAt
}

model QboVendor {
  id          String   @id
  displayName String
  active      Boolean  @default(true)
  syncedAt    DateTime @updatedAt
}

/// One row per transaction line across Purchase, Bill, Invoice,
/// JournalEntry. This is the pivot/Power BI fact table.
model QboTransactionLine {
  id             String   @id // `${txnType}:${txnId}:${lineIndex}`
  txnId          String
  txnType        String // Purchase | Bill | Invoice | JournalEntry
  txnDate        DateTime @db.Date
  docNumber      String?
  accountId      String?
  accountName    String? // denormalized for pivoting
  accountType    String? // denormalized
  classification String? // denormalized: Revenue / Expense / etc.
  entityName     String? // vendor (expenses) or customer (income)
  memo           String?
  amount         Decimal  @db.Decimal(14, 2) // signed: expenses +, credits -
  postingType    String? // Debit | Credit (journal entries only)
  syncedAt       DateTime @updatedAt

  @@index([txnDate])
  @@index([accountName])
  @@index([entityName])
  @@index([txnType])
}

model QboSyncState {
  id             String    @id @default("singleton")
  lastCdcAt      DateTime? // watermark for Change Data Capture
  fullSyncDoneAt DateTime?
  lastRunStatus  String?
  updatedAt      DateTime  @updatedAt
}

model ShiftSection {
  id        String  @id @default(cuid())
  listType  String              // APERTURA | CIERRE | LIMPIEZA
  name      String
  dayOfWeek Int?                // LIMPIEZA only: 1=Lunes .. 4=Jueves
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)
  tasks     ShiftTask[]
}

model ShiftTask {
  id         String  @id @default(cuid())
  sectionId  String
  section    ShiftSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  text       String
  daysOfWeek String?            // comma ISO days e.g. "4,7". null = every day
  sortOrder  Int     @default(0)
  isActive   Boolean @default(true)
  checks     ShiftTaskCheck[]
  deferrals  ShiftDeferral[]
}

model ShiftRun {
  id               String    @id @default(cuid())
  listType         String
  businessDate     String    // YYYY-MM-DD
  completedAt      DateTime?
  shareAttemptedAt DateTime?
  createdAt        DateTime  @default(now())
  checks           ShiftTaskCheck[]
  staff            ShiftRunStaff[]
  deferrals        ShiftDeferral[]
  @@unique([listType, businessDate])
}

model ShiftRunStaff {
  id           String   @id @default(cuid())
  runId        String
  run          ShiftRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  sectionId    String
  employeeId   String
  employeeName String
  @@unique([runId, sectionId, employeeId])
}

model ShiftTaskCheck {
  id        String    @id @default(cuid())
  runId     String
  run       ShiftRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  taskId    String
  task      ShiftTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  checkedAt DateTime  @default(now())
  @@unique([runId, taskId])
}

model ShiftDeferral {
  id          String    @id @default(cuid())
  taskId      String
  task        ShiftTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  runId       String
  run         ShiftRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  reason      String
  plannedFor  String    // ESTA_NOCHE | PROXIMA_APERTURA
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())
}

// ─────────────────────────────────────────────────────────────
// Daily tip distribution
// Worker identity is the Clover employeeId string, matching
// ShiftRunStaff and SalonRestock. TipShiftEntry.userId is an
// optional bridge to User for future payroll rollup.
// ─────────────────────────────────────────────────────────────

enum TipDayStatus {
  BORRADOR
  ENVIADO
}

enum TipEntryRole {
  MESERO
  BUSSER
}

enum TipTargetField {
  CREDIT_TIPS
  SERVICE_CHARGE
  CASH_TIPS
  ENTRY_ADJUSTMENT
  SUBMISSION_REOPENED
}

model TipDay {
  id                    String              @id @default(cuid())
  businessDate          DateTime            @unique @db.Date
  cloverCreditTips      Decimal?            @db.Decimal(10,2)
  cloverServiceCharge   Decimal?            @db.Decimal(10,2)
  cloverCashTips        Decimal?            @db.Decimal(10,2)
  cloverSyncedAt        DateTime?
  // What the last sync did. Diagnostics for a run that came back wrong, not
  // figures anyone is paid from.
  cloverSyncDurationMs  Int?
  cloverOrdersScanned   Int?
  cloverPaymentsScanned Int?
  totalCreditTips       Decimal             @db.Decimal(10,2) @default(0)
  totalServiceCharge    Decimal             @db.Decimal(10,2) @default(0)
  totalCashTips         Decimal             @db.Decimal(10,2) @default(0)
  status                TipDayStatus        @default(BORRADOR)
  submittedAt           DateTime?
  submittedByCloverId   String?
  submittedByName       String?
  shifts                TipShift[]
  overrides             TipTargetOverride[]
  employeeTips          TipDayEmployeeTip[]
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  @@index([businessDate])
}

model TipTargetOverride {
  id                String         @id @default(cuid())
  tipDayId          String
  tipDay            TipDay         @relation(fields: [tipDayId], references: [id], onDelete: Cascade)
  // Set for entry-level adjustments, null for day-level ones. SetNull rather
  // than Cascade on purpose: deleting an entry must not erase the record that
  // it was changed.
  entryId           String?
  entry             TipShiftEntry? @relation(fields: [entryId], references: [id], onDelete: SetNull)
  field             TipTargetField
  previousValue     Decimal        @db.Decimal(10,2)
  newValue          Decimal        @db.Decimal(10,2)
  reason            String?
  changedByCloverId String
  changedByName     String
  createdAt         DateTime       @default(now())
  @@index([tipDayId])
  @@index([entryId])
}

model TipShift {
  id               String          @id @default(cuid())
  tipDayId         String
  tipDay           TipDay          @relation(fields: [tipDayId], references: [id], onDelete: Cascade)
  orderIndex       Int
  entries          TipShiftEntry[]
  filledByCloverId String?
  filledByName     String?
  filledAt         DateTime?
  createdAt        DateTime        @default(now())
  @@unique([tipDayId, orderIndex])
}

model TipShiftEntry {
  id                          String       @id @default(cuid())
  tipShiftId                  String
  tipShift                    TipShift     @relation(fields: [tipShiftId], references: [id], onDelete: Cascade)
  cloverEmployeeId            String
  employeeName                String
  userId                      String?
  user                        User?        @relation(fields: [userId], references: [id])
  role                        TipEntryRole
  creditTips                  Decimal      @db.Decimal(10,2) @default(0)
  serviceCharge               Decimal      @db.Decimal(10,2) @default(0)
  cashTips                    Decimal?     @db.Decimal(10,2)
  cashZeroConfirmedByCloverId String?
  cashZeroConfirmedByName     String?
  cashZeroConfirmedAt         DateTime?
  overrides                   TipTargetOverride[]
  createdAt                   DateTime     @default(now())
  updatedAt                   DateTime     @updatedAt
  @@unique([tipShiftId, cloverEmployeeId])
  @@index([cloverEmployeeId])
  @@index([userId])
}

// A cache of what Clover reported per employee, refreshed wholesale on every
// sync. It is never edited by hand and it is NOT the authoritative
// distribution — TipShiftEntry is, and stays so. Nothing here is what anyone is
// owed; it exists to be compared against what the staff entered.
model TipDayEmployeeTip {
  id               String   @id @default(cuid())
  tipDayId         String
  tipDay           TipDay   @relation(fields: [tipDayId], references: [id], onDelete: Cascade)
  cloverEmployeeId String
  employeeName     String
  paymentCount     Int      @default(0)
  cardTips         Decimal  @db.Decimal(10,2) @default(0)
  serviceCharge    Decimal  @db.Decimal(10,2) @default(0)
  salesAmount      Decimal  @db.Decimal(10,2) @default(0)
  syncedAt         DateTime @default(now())
  @@unique([tipDayId, cloverEmployeeId])
  @@index([tipDayId])
}

// ─────────────────────────────────────────────────────────────
// Weekly payroll and retention
// Worker identity is the Clover employeeId string, as in the tip
// models. PayrollEntry.role reuses TipEntryRole rather than
// declaring a second copy of the same two roles.
// ─────────────────────────────────────────────────────────────

enum PayrollWeekStatus {
  BORRADOR
  CERRADO
}

enum RetentionKind {
  RETENCION
  ENTREGA
  // An advance handed to the worker, and a repayment deducted from a later
  // check. A DESCUENTO carries the advanceId of the ADELANTO it pays down, so
  // the two are joinable without a stored balance sitting between them.
  ADELANTO
  DESCUENTO
}

model PayrollRateConfig {
  id            String   @id @default("singleton")
  serverRate    Decimal  @db.Decimal(6,2)
  busserRate    Decimal  @db.Decimal(6,2)
  minimumWage   Decimal  @db.Decimal(6,2)
  cushionAmount Decimal  @db.Decimal(6,2) @default(0)
  updatedAt     DateTime @updatedAt
}

model PayrollWeek {
  id            String            @id @default(cuid())
  weekEnding    DateTime          @unique @db.Date
  status        PayrollWeekStatus @default(BORRADOR)
  hoursSyncedAt DateTime?
  entries       PayrollEntry[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  @@index([weekEnding])
}

model PayrollEntry {
  id               String       @id @default(cuid())
  payrollWeekId    String
  payrollWeek      PayrollWeek  @relation(fields: [payrollWeekId], references: [id], onDelete: Cascade)
  cloverEmployeeId String
  employeeName     String
  // Nullable: TipEntryRole describes a TIPPED shift, and kitchen staff work
  // none. Defaulting them to MESERO would put a role in a settled record that
  // the person never held.
  role             TipEntryRole?
  hoursWorked      Decimal      @db.Decimal(7,2) @default(0)
  // A BLEND when the person worked more than one role that week: the weighted
  // average of the daily rates. It is a rounded 2dp summary, so
  // hoursWorked x hourlyRate does NOT reliably reproduce wageTotal — that is
  // why wageTotal is stored rather than derived.
  hourlyRate       Decimal      @db.Decimal(6,2) @default(0)
  // What was actually earned in wages that week, summed from the per-day
  // figures before any rounding to a rate. This is the authoritative amount.
  wageTotal        Decimal      @db.Decimal(10,2) @default(0)
  tipsTotal        Decimal      @db.Decimal(10,2) @default(0)
  // ── How the week was PAID OUT, in two independent pairs ──
  //
  // adpTips / checkTips  — how TIPS were divided.
  //   Salón only. Zero for kitchen, who receive no tips at all.
  //
  // adpWage / checkWage  — how WAGES were divided.
  //   Kitchen only, from their configured adpHours x adpRate. For salón the
  //   whole wage goes through ADP, so adpWage = wageTotal and checkWage = 0.
  //
  // The pairs are independent: within each, the two columns sum to that side's
  // total (tipsTotal, wageTotal). Adding across the pairs is what someone
  // reconstructing a paycheck does — adpTips + adpWage is the ADP side,
  // checkTips + checkWage is the check side.
  adpTips          Decimal      @db.Decimal(10,2) @default(0)
  checkTips        Decimal      @db.Decimal(10,2) @default(0)
  adpWage          Decimal      @db.Decimal(10,2) @default(0)
  checkWage        Decimal      @db.Decimal(10,2) @default(0)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  @@unique([payrollWeekId, cloverEmployeeId])
  @@index([cloverEmployeeId])
}

model RetentionSetting {
  cloverEmployeeId String   @id
  employeeName     String
  isActive         Boolean  @default(false)
  percentage       Decimal  @db.Decimal(5,2) @default(0)
  updatedAt        DateTime @updatedAt
}

// Signed ledger. amount is ALWAYS stored positive; kind carries the direction.
// A RETENCION is money held, an ENTREGA is money paid back out in their name,
// so the balance held is the sum of RETENCION minus the sum of ENTREGA — any
// query that adds the rows without subtracting ENTREGA reports the wrong
// figure. The balance is never stored: a running total that can be edited
// independently of the rows that produced it will drift.
// payrollWeekId is a loose reference with no relation, deliberately — deleting
// a week must not cascade away the record of money held.
model RetentionLedger {
  id               String        @id @default(cuid())
  cloverEmployeeId String
  employeeName     String
  kind             RetentionKind
  amount           Decimal       @db.Decimal(10,2)
  percentageUsed   Decimal?      @db.Decimal(5,2)
  payrollWeekId    String?
  // Which SalaryAdvance a DESCUENTO row pays down. No relation, deliberately,
  // for the same reason as payrollWeekId — deleting an advance must not cascade
  // away the record that the money was repaid.
  advanceId        String?
  note             String?
  recordedByName   String?
  createdAt        DateTime      @default(now())
  @@index([cloverEmployeeId])
  @@index([payrollWeekId])
  @@index([advanceId])
}

enum Department {
  SALON
  COCINA
}

// Per-person payroll configuration.
//
// hourlyRate is the person's REAL rate and takes precedence; PayrollRateConfig
// stays the role-based fallback for anyone without a row here. That is what
// lets a Line Cook be paid a cook's rate rather than the server rate their
// absent tip role would otherwise imply.
//
// The ADP portion of a week is adpHours x adpRate, and the check covers total
// earned minus that. Each is null-means-default: adpHours null means all hours
// worked, adpRate null means hourlyRate. With both null the person is entirely
// on ADP at their real rate and the check is zero.
//
// Two nullable fields rather than a mode enum: a mode would need a value for
// every combination these already express, and the two could then disagree.
model EmployeeRate {
  cloverEmployeeId String      @id
  employeeName     String
  // Null means nobody has set a rate yet, which is NOT zero — a wage of $0.00
  // reads as a calculated figure and this is the absence of one. The role sync
  // creates rows for people it has never seen so their Clover role has a home,
  // and it will not invent a rate to do it. saveEmployeeConfig still refuses
  // anything at or below zero, so no rate entered by hand can land here null.
  hourlyRate       Decimal?    @db.Decimal(6,2)
  department       Department? // null derives the department from the Clover role
  // The role as Clover last reported it, cached so the payroll page never
  // depends on Clover being reachable. Refreshed only by an explicit user
  // action, never on render.
  cloverRole       String?
  cloverRoleAt     DateTime?
  adpHours         Decimal?    @db.Decimal(5,2)
  adpRate          Decimal?    @db.Decimal(6,2)
  // The person's name exactly as it appears in ADP's exports, so a row naming
  // them can be matched back to a Clover id. ADP writes "Ayala, Piero R" where
  // Clover has "Piero" — the two will not match on anything but an explicit
  // mapping, which is what this column is.
  //
  // AdpRun itself is run-level and never names anybody, so nothing reads this
  // yet. It is kept because the mapping is wanted regardless: any per-person
  // ADP figure is unusable without it, and the names are easier to collect now,
  // while someone is looking at them, than to reconstruct later.
  adpName          String?
  // Hides the person from the CONFIG panel only. It must NEVER remove them from
  // a payroll report: someone with hours that week still appears there and still
  // gets paid. Hiding is decluttering, not exclusion — getPayrollWeek does not
  // read this column, and must not start.
  isHidden         Boolean     @default(false)
  // A human explicitly asked for this person in the config panel, so they are
  // listed even with no rate and no recent work.
  //
  // This exists because isHidden cannot carry that meaning: it defaults to false
  // on all 56 rows, so "not hidden" is indistinguishable from "nobody has ever
  // touched this row". Without a separate flag, adding someone back would clear
  // isHidden, change nothing the relevance rule reads, and silently no-op.
  isPinned         Boolean     @default(false)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

// An advance paid to a worker, repaid by weekly deductions from their check.
//
// Repayments are RetentionLedger rows with kind DESCUENTO carrying this
// advance's id in advanceId, so the outstanding balance is principalAmount
// minus the sum of those rows. The balance is never stored: a running total
// that can be edited independently of the rows that produced it will drift,
// and the rows are the record of what actually changed hands.
//
// Repayment begins the week AFTER startWeekEnding — that week is when the money
// is handed over, not when it starts coming back.
model SalaryAdvance {
  id               String   @id @default(cuid())
  cloverEmployeeId String
  employeeName     String
  principalAmount  Decimal  @db.Decimal(10,2)
  weeklyDeduction  Decimal  @db.Decimal(10,2)
  startWeekEnding  DateTime @db.Date
  note             String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  @@index([cloverEmployeeId])
}

// ─────────────────────────────────────────────────────────────
// Imported timesheet punches
// ─────────────────────────────────────────────────────────────

enum PunchSource {
  IMPORTADO
  MANUAL
}

// One clock-in/clock-out pair, as recorded by the time clock.
//
// Worker identity here is the NAME as the timesheet export gives it, because
// the export carries no employee id. cloverEmployeeId is resolved on import
// where the name matches the Clover roster and left null where it does not —
// an unmatched name is surfaced at import time, never silently dropped.
//
// businessDate is derived from clockIn under the 5 AM cutover, so a shift that
// ends after midnight belongs entirely to the evening it started.
model PayrollPunch {
  id               String      @id @default(cuid())
  businessDate     DateTime    @db.Date
  employeeName     String
  cloverEmployeeId String?
  clockIn          DateTime
  clockOut         DateTime?
  hours            Decimal     @db.Decimal(7,2) @default(0)
  source           PunchSource @default(IMPORTADO)
  isFlagged        Boolean     @default(false)
  flagReason       String?
  importBatchId    String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  @@index([businessDate])
  @@index([employeeName])
  @@index([cloverEmployeeId])
  @@index([importBatchId])
}

// ─────────────────────────────────────────────────────────────
// Imported ADP payroll cost
//
// Source is ADP's "Payroll Liability" report: one file per check date, laid out
// as labelled rows rather than a table. It is deliberately NOT the "Payroll
// Detail" export — Liability carries the employer's own cost, which is the
// whole point of this model, and it carries no SSN, TIN or per-person pay data
// to have to be careful with.
//
// NEVER store bank account or routing numbers. The report carries them; the app
// has no use for them, and holding them creates a custodial obligation it does
// not need. Drop them at the parser, not at the query.
// ─────────────────────────────────────────────────────────────

// One ADP payroll run — a single check date, at run level.
//
// This model exists because nothing in this schema stored what the EMPLOYER
// paid. Everything before it — PayrollEntry.wageTotal, tipsTotal, the adp/check
// splits — is gross pay from the worker's side. The employer's own liability
// (SS and Medicare match, NJ SUI and SDI, FUTA, workers comp, ADP's fee) was
// recorded nowhere, so every labor-cost figure the app has reported to date is
// understated by that entire amount: employer tax alone runs ~11% of gross on
// the sample run, more once workers comp and the fee are counted. A cost number
// that is consistently ~11% low is not a rounding problem, it is the wrong
// number, and importing this is what fixes it.
//
// The employer's true cost of a run is:
//
//   erTaxTotal + workersComp + serviceFee
//
// Do NOT reach for totalCashRequired for that. It is cash out the door, which
// includes the employees' own money — their net pay and the tax withheld from
// them. It answers "what leaves the bank", not "what this cost us".
//
// Nor is erTaxTotal a debit on top of the others. It is already INSIDE
// debitTaxes, which remits employee withholding and employer contribution
// together, so on the sample run:
//
//   debitTaxes 919.07 = employer 436.75 + employee 482.32
//   totalCashRequired 4376.82 = 919.07 + 922.86 + 2474.06 + 60.83
//                               taxes    checks   FSDD      workers comp
//
// Adding erTaxTotal to totalCashRequired double counts it.
//
// Do not confuse any of this with PayrollEntry.adpWage / adpTips either. Those
// are the ROUTING DECISION made before the run — how much of a week's gross was
// sent to ADP to process versus paid by handwritten check. This model is what
// came back: what ADP actually withheld, remitted and billed. They answer
// different questions, and the names are close enough that a reader will
// conflate them without this note.
//
//   PayrollEntry.adpWage → what we told ADP to run
//   AdpRun.erTaxTotal    → what it cost us on top, which nothing else knows
//
// They can legitimately disagree — a correction, an off-cycle check, a mid-week
// change — and a difference is a fact worth surfacing, not an error to reconcile
// away by overwriting one with the other.
model AdpRun {
  id                 String   @id @default(cuid())
  checkDate          DateTime @db.Date
  payrollNumber      String?
  erSocSec           Decimal  @db.Decimal(10,2) @default(0)
  erMedicare         Decimal  @db.Decimal(10,2) @default(0)
  erFuta             Decimal  @db.Decimal(10,2) @default(0)
  erSui              Decimal  @db.Decimal(10,2) @default(0)
  erSdi              Decimal  @db.Decimal(10,2) @default(0)
  // "Total Employer Tax Contributions" as ADP states it, stored rather than
  // summed from the five above so an import that failed to find a line cannot
  // quietly report a smaller total than the report did.
  erTaxTotal         Decimal  @db.Decimal(10,2) @default(0)
  // "Pay-by-Pay Insurance" — workers comp premium. An employer cost, but not a
  // tax, so it sits outside erTaxTotal and has to be added separately.
  workersComp        Decimal  @db.Decimal(10,2) @default(0)
  // ADP's own processing fee. Nullable because the report CANNOT carry it: the
  // fee invoice arrives the Monday after the run and debits three days later,
  // so at import time it does not exist yet and is entered by hand.
  //
  // Null therefore means "not entered yet", which is NOT zero. A run still
  // awaiting its fee is an incomplete cost, and treating null as 0 would report
  // it as a finished one that happened to be free.
  serviceFee         Decimal? @db.Decimal(10,2)
  // The three debits ADP takes, straight from the report. Employee money and
  // employer money mixed together — see the note above before summing them.
  debitTaxes         Decimal  @db.Decimal(10,2) @default(0)
  debitChecks        Decimal  @db.Decimal(10,2) @default(0)
  debitDirectDeposit Decimal  @db.Decimal(10,2) @default(0)
  totalCashRequired  Decimal  @db.Decimal(10,2) @default(0)
  // The rates ADP assessed this run, as percentages (FUTA 0.6, SUI 2.8,
  // SDI 0.5). Recorded because they are reset periodically and a cost that
  // moved needs the rate change visible next to it. Nullable: older imports may
  // not have them, and a guessed rate is worse than an absent one.
  futaRate           Decimal? @db.Decimal(6,3)
  suiRate            Decimal? @db.Decimal(6,3)
  sdiRate            Decimal? @db.Decimal(6,3)
  importedAt         DateTime @default(now())
  updatedAt          DateTime @updatedAt
  @@unique([checkDate, payrollNumber])
  @@index([checkDate])
}
