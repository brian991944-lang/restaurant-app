+        }
+    } else {
+        result.google.error = 'TIME';
+    }
+
+    // ── Clover item audit ──
+    if (elapsed() <= SYNC_BUDGET_MS) {
+        try {
+            const r = await syncCloverSales();
+            result.clover = r.success ? { ran: true, items: r.count ?? 0, error: null } : { ran: true, items: 0, error: 'FAILED' };
